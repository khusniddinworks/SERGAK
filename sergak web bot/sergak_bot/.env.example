# =============================================
# SERGAK BOT - MAXFIY SOZLAMALAR (.env fayli)
# =============================================
# Bu faylni .env nomiga o'zgartirib to'ldiring
# .env faylini hech qachon GitHub yoki boshqalarga ko'rsatmang!

# BotFather dan olingan token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Sizning Telegram user ID (admin)
# Bilish uchun: @userinfobot ga /start yuboring
ADMIN_ID=YOUR_TELEGRAM_USER_ID_HERE

# Bot xavfsizlik imzosi (ixtiyoriy, lekin tavsiya etiladi)
# Ixtiyoriy 32+ belgidan iborat maxfiy kalit
SECRET_KEY=your_very_long_secret_key_here_min_32_chars

# APK fayl joylashuvi (to'liq yo'l)
APK_PATH=../ai_ximoyachi/build/app/outputs/flutter-apk/app-release.apk

# Website papkasi joylashuvi
WEBSITE_PATH=../sergak_website
